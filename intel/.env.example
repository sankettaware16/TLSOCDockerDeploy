# Threat-intelligence collector settings.
# Copy to intel/.env and fill in the feeds you want. The real .env is
# git-ignored and must never be committed. Feeds without a key are skipped.

# Where the collectors write (must be the folder Logstash mounts, i.e. the
# engine output folder; ENGINE_OUTPUT_DIR from the stack .env is used if this
# is empty). Files go to <dir>/threat_intel/<feed>.json
TLSOC_OUTPUT_DIR=/var/log/soc_output

# AbuseIPDB - https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
ABUSEIPDB_MIN_CONFIDENCE=90

# AlienVault OTX - https://otx.alienvault.com/settings
OTX_API_KEY=

# MISP - your own instance
MISP_URL=
MISP_KEY=
MISP_VERIFY_SSL=true
MISP_TO_IDS_ONLY=false
