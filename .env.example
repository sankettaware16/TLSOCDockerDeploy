ELASTIC_VERSION=8.19.12

# Generated automatically by install.sh on a fresh install (random, stored only
# here). Leave the placeholders as they are; the installer replaces them.
ELASTIC_PASSWORD=ChangeMeElastic
KIBANA_PASSWORD=ChangeMeKibana

# Generated automatically by install.sh (64 hex chars). Do not share or commit.
# Keep it stable: changing it makes existing encrypted Kibana saved objects
# (alerting rules, connectors) unreadable.
KIBANA_ENCRYPTION_KEY=

ELASTIC_HEAP=1g
KIBANA_PORT=5601
HOST_IP=<IP_OF_THIS_MACHINE>

# Folder where the TLSOC Engine writes its ECS NDJSON output (engine config
# `paths.output_dir`). Mounted read-only into Logstash. Must match the engine.
ENGINE_OUTPUT_DIR=/var/log/soc_output

# ---------------------------------------------------------------------------
# Data retention (Elasticsearch ILM) - applied by install.sh and by
#   ./elasticsearch/setup_storage.py     (re-run it after editing these)
# Guidance and sizing: docs/retention-and-storage.md
# ---------------------------------------------------------------------------
# How long parsed logs (fosstlsoc-logs-*) are kept, in days. 180 is the minimum
# rolling period required of Indian organisations by the CERT-In Directions of
# 28 April 2022. Check the disk it needs with ./elasticsearch/retention_report.py
LOG_RETENTION_DAYS=180
# After this many days an index is compacted (merged to one segment, better
# compression) to save space and speed up searches. Must be below the retention.
WARM_AFTER_DAYS=7
# Very chatty sources (for example squid, dns) can be kept for less time so they
# do not fill the disk. Comma-separated source names (= index name part:
# fosstlsoc-logs-<source>-*). Empty = every source uses LOG_RETENTION_DAYS.
HIGH_VOLUME_SOURCES=
HIGH_VOLUME_RETENTION_DAYS=30
# Self-monitoring data (tlsoc-health-*, feeds the SOC Overview dashboard).
HEALTH_RETENTION_DAYS=90
# Shards per daily index and replicas. This stack is a single Elasticsearch node,
# so replicas must stay 0 (a replica can never be placed; the cluster would stay
# yellow). Raise INDEX_SHARDS if one source exceeds ~50 GB per day.
INDEX_SHARDS=1
INDEX_REPLICAS=0
